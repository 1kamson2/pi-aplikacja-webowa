@namespace App.Components.Widgets
@layout Layout.MainLayout
@inherits Widget
@using Core.History
@using static Pages.Shared.WidgetAction

<div class="widget popup">
    <div class="popup-header">
        <span class="popup-title">Historia szyfrowania</span>
        <Button ActionType=ClosePopup
                Id=67
                ActionRequestedEvent=RelayButtonPayload>
            <Content>
                ✕
            </Content>
        </Button>
    </div>

    @if (HistorySingleton.Entries.Count == 0)
    {
        <div class="widget-empty-container">
            <p class="widget-empty">Brak historii szyfrowania</p>
        </div>
    }
    else
    {
        <div class="widget-list">
            @foreach (var entry in HistorySingleton.Entries)
            {
                <div class="widget-inner-item" @key="entry.Id">
                    <img src="data:image/png;base64,@Convert.ToBase64String(entry.EncryptedData)" alt="@entry.FileName" />
                    <div class="widget-meta">
                        <strong>@entry.FileName</strong>
                        <small>@entry.Algorithm · @entry.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                    </div>
                    <button class="widget-btn widget-remove file-remove-inline" title="Usuń" @onclick="() => HistorySingleton.Remove(entry.Id)" @onclick:stopPropagation="true">✕</button>
                </div>
            }
        </div>
    }

    @if (HistorySingleton.Entries.Count > 0)
    {
        <div class="widget-footer">
            <button class="widget-btn widget-remove file-remove-inline" @onclick="HistorySingleton.Clear">Wyczyść historię</button>
        </div>
    }
</div>