@namespace App.Components.Widgets
@inherits Widget
@using Core.Algorithm
@using static Pages.Shared.WidgetAction

<div class="widget popup">
    <div class="popup-header">
        <span class="popup-title">Algorytmy</span>
        <Button ActionType=ClosePopup
                Id=67
                ActionRequestedEvent=RelayButtonPayload>
            <Content>
                ✕
            </Content>
        </Button>
    </div>

    @if (AlgorithmSingleton.Entries.Count == 0)
    {
        <div class="widget-empty-container">
            <p class="widget-empty">Brak algorytmów</p>
        </div>
    }
    else
    {
        <div class="widget-list">
            @foreach (var entry in AlgorithmSingleton.Entries)
            {
                <div class="widget-inner-item" @key="entry.Id" title="@entry.Description" @onclick="() => AlgorithmSingleton.SelectAlgorithm(entry.Id)">
                    <div class="widget-meta">
                        <strong>@entry.Name</strong>
                        <small>
                            @entry.Category
                            @if (entry.KeySizeBits > 0)
                            {
                                <text> · klucz @entry.KeySizeBits bit</text>
                            }
                        </small>
                    </div>
                    @if (!entry.IsImplemented)
                    {
                        <span class="algorithm-badge">wkrótce</span>
                    }
                    <button class="widget-btn widget-remove file-remove-inline" title="Usuń" @onclick="() => AlgorithmSingleton.Remove(entry.Id)" @onclick:stopPropagation="true">✕</button>
                </div>
            }
        </div>
    }

    @if (AlgorithmSingleton.Entries.Count > 0)
    {
        <div class="widget-footer">
            <button class="widget-btn widget-remove file-remove-inline" @onclick="AlgorithmSingleton.Clear">Wyczyść algorytmy</button>
        </div>
    }
</div>