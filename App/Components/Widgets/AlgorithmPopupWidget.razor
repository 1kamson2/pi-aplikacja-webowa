@namespace App.Components.Widgets
@inherits Widget
@using static Pages.Shared.WidgetAction

<div class="widget popup">
    <div class="popup-header">
        <span class="popup-title">Algorytmy</span>
        <Button ActionType=ClosePopup
                Id=67
                ActionRequestedEvent=RelayButtonPayload>
            <Content>
                ✕
            </Content>
        </Button>
    </div>

    @if (!HasContent())
    {
        <div class="widget-empty-container">
            <p class="widget-empty">Brak algorytmów</p>
        </div>
    }
    else
    {
        <div class="widget-list">
            @foreach (var entry in AlgorithmSingleton.Entries)
            {
                <div class="widget-inner-item algorithm-card" @key="entry.Hash" title="@entry.Description" @onclick="() => AlgorithmSingleton.SelectAlgorithm(entry.Hash)">
                    <div class="algorithm-card-header-content">
                        <div class="algorithm-icon-badge">
                            <svg class="alg-lock-icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        </div>
                        <div class="algorithm-badges">
                            @if (!entry.IsImplemented)
                            {
                                <span class="algorithm-badge-coming">wkrótce</span>
                            }
                            @if (entry.KeySizeBits > 0)
                            {
                                <span class="algorithm-badge-key">klucz @entry.KeySizeBits bit</span>
                            }
                        </div>
                    </div>

                    <div class="algorithm-description-text">
                        <span>@entry.Description</span>
                    </div>

                    <div class="algorithm-card-footer">
                        <div class="widget-meta">
                            <strong>@entry.Name</strong>
                            <small>@entry.Category</small>
                        </div>
                        <button class="widget-btn widget-remove file-remove-inline" title="Usuń" @onclick="() => AlgorithmSingleton.Remove(entry.Hash)" @onclick:stopPropagation="true">
                            <span>✕</span>
                        </button>
                    </div>

                </div>
            }
        </div>
    }

    @if (HasContent())
    {
        <div class="widget-footer">
            <button class="widget-btn widget-remove file-remove-inline" @onclick="AlgorithmSingleton.Clear">Wyczyść algorytmy</button>
        </div>
    }
</div>