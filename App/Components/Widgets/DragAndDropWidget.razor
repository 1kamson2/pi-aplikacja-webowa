@namespace App.Components.Widgets
@layout Components.Layout.MainLayout
@inherits Widget

<div class="drag-drop-layout @(HasContent() ? "has-active-image" : "")">
    <div @oncontextmenu="OnFileDeleted" @oncontextmenu:preventDefault @onwheel="OnWheel" class="widget drag-and-drop-zone @(HasContent() ? "has-image" : "")">
        <InputFile OnChange="OnFileSelected" accept=".png,image/png" class="drop-input" />

        @if (HasContent())
        {
            var slides = Slides();
            SyncSlide(slides);
            var index = Math.Max(0, slides.FindIndex(s => s.Kind == _slide));

            <div class="drop-preview">
                <div class="drop-track" style="transform:translateX(-@(index * 100)%)">
                    @foreach (var s in slides)
                    {
                        <div class="drop-slide" @key="s.Kind">
                            <img src="@UrlFor(s.Kind, s.Data)" alt="@s.Label" class="@(s.Kind == SlideKind.Encrypted ? "pixelated" : "")" />
                        </div>
                    }
                </div>
            </div>

            @if (slides.Count > 1)
            {
                <div class="drop-tabs" @oncontextmenu:stopPropagation="true">
                    @foreach (var s in slides)
                    {
                        <button type="button" @key="s.Kind"
                                class="drop-tab @(s.Kind == _slide ? "active" : "")"
                                @onclick="() => SelectSlide(s.Kind)">@s.Label</button>
                    }
                </div>
            }
        }
        else
        {
            <span> Drag & Drop</span>
            @Content
        }
    </div>

    @if (HasContent())
    {
        <div class="file-info-inline">
            <div class="file-name-text" title="@FileMetadata.Filename">@FileMetadata.Filename</div>
            <div class="file-size-text">@String.Format("{0:0.00}", ImageSizeInMB()) MB</div>
            <button class="widget-btn widget-remove file-remove-inline" @onclick="OnFileDeleted" title="Usuń plik">
                <span>Usuń plik</span>
            </button>
        </div>
    }
</div>