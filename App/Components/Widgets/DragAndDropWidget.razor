@namespace App.Components.Widgets
@layout Components.Layout.MainLayout
@inherits Widget

<div class="drag-drop-layout @(HasImage() ? "has-active-image" : "")">
    <div @oncontextmenu="OnFileDeleted" @oncontextmenu:preventDefault class="widget drag-and-drop-zone @(HasImage() ? "has-image" : "")">
        <InputFile OnChange="OnFileSelected" accept=".png,image/png" class="drop-input" />

        @if (HasError())
        {
            <div class="drop-error">@FileLoadErrorMessage</div>
        }

        @if (HasImage())
        {
            <div class="drop-preview">
                <img src="data:image/png;base64,@Convert.ToBase64String(FileData)" alt="@FileName" />
            </div>
        }
        else
        {
            <span> Drag & Drop</span>
            @Content
        }
    </div>

    @if (HasImage())
    {
        <div class="file-info-inline">
            <div class="file-name-text" title="@FileName">@FileName</div>
            <div class="file-size-text">@String.Format("{0:0.00}", ImageSizeInMB()) MB</div>
            <button class="widget-btn widget-remove file-remove-inline" @onclick="OnFileDeleted" title="Usuń plik">
                <span>Usuń plik</span>
            </button>
        </div>
    }
</div>