@namespace App.Components.Widgets
@layout Components.Layout.MainLayout
@inherits Widget

<div @oncontextmenu="OnFileDeleted" @oncontextmenu:preventDefault class="widget drag-and-drop-zone">
    <InputFile OnChange="OnFileSelected" accept=".png,image/png" class="drop-input" />

    @if (HasError())
    {
        <div class="drop-error">@FileLoadErrorMessage</div>
    }

    @if (HasImage())
    {
        <div class="drop-preview">
            <img src="data:image/png;base64,@Convert.ToBase64String(ImageData)" alt="@FileName" />
            <small>@FileName (@String.Format("{0:0.00}", ImageSizeInMB()) MB)</small>
        </div>
    } else
    {
        <span> Drag & Drop</span>
        @Content
    }
</div>