@namespace App.Components.Widgets
@layout Components.Layout.MainLayout
@inherits BaseWidget<WidgetPayload>;
@using Pages.Shared;

<div class="widget" @onclick=EmitSignal>
    <div class="widget-header-group">
        <span class="widget-title">Histogramy</span>
        <span class="widget-desc">Wyswietl histogramy dla poszczegolnych obrazow</span>
    </div>

    @if (!HasContent())
    {
        <div class="widget-body-content">
            <div class="widget-status-group">
                <span class="pulse-dot waiting-dot"></span>
                <span class="status-label">Brak histogramów</span>
            </div>
        </div>
    }
    else
    {
        <div class="widget-body-content">
            <div class="widget-status-group">
                <span class="metric-value">@HistogramSingleton.Entries.Count</span>
                <span class="metric-label">wpisów w histogramach</span>
            </div>
        </div>
    }
</div>