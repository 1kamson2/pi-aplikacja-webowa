@page "/"
@layout Components.Layout.MainLayout
@inherits Core.Components.BasePage

<section class="workspace-canvas anim-home" @onwheel=@OnMouseScroll>
    <div class="workspace-grid">
        <div class="widget drag-and-drop-zone">
                <span>Drag & Drop</span>
                <img class="icon" src="icons/drag&drop-icon.png"/>
        </div>
        <div class="scroll-zone">
            <p>Scroll down</p>
        </div>
    </div>
</section>
