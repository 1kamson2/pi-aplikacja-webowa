@page "/control-panel"
@namespace App.Components.Pages
@layout Components.Layout.MainLayout
@inherits Shared.BasePage
@using Core.Algorithm

@using static Shared.WidgetAction
@using static Shared.WidgetType

<section class="workspace-canvas anim-control-panel" @onwheel="OnMouseScroll" tabindex="0" @onkeydown="OnKeyboardKeyClicked">
    <div class="widget widget-dashboard">
        <div class="widget-container">
            <SaveImageWidget InstanceType=SaveImage
                             ActionRequestedEvent=OnWidgetClicked>
                <Content>
                    <span> Zapisz obraz </span>
                    <img class="icon" src="icons/save-icon.png" />
                </Content>
            </SaveImageWidget>
            <HistoryWidget InstanceType=History
                           ActionType=OpenPopup
                           ActionRequestedEvent=OnWidgetClicked>
                <Content>
                    <span> Historia </span>
                    <img class="icon" src="icons/encryption-icon.png" />
                </Content>
            </HistoryWidget>
            <HistogramsWidget InstanceType=Histograms
                              ActionType=OpenPopup
                              ActionRequestedEvent=OnWidgetClicked>
                <Content>
                    <span> Histogramy </span>
                    <img class="icon" src="icons/histogram-icon.png" />
                </Content>
            </HistogramsWidget>
            <Widget InstanceType=Algorithms
                    ActionType=OpenPopup
                    ActionRequestedEvent=OnWidgetClicked>
                <Content>
                    <span> Algorytmy </span>
                    <img class="icon" src="icons/algorithm-icon.png" />
                </Content>
            </Widget>
        </div>
        <div class="enc-dec-container">
            <EncryptionWidget InstanceType=Encryption
                              ActionType=StartEncryption
                              ActionRequestedEvent=OnWidgetClicked>
                <Content>
                    <span> Zaszyfruj obraz </span>
                    @if (AlgorithmSingleton.Instance.ChosenAlgorithm is { } chosen)
                    {
                        <small style="color: var(--widget-text-color-muted);">używając algorytmu <strong>@chosen.Name</strong></small>
                    }
                </Content>
            </EncryptionWidget>

            <DecryptionWidget InstanceType=Decryption
                              ActionType=StartDecryption
                              ActionRequestedEvent=OnWidgetClicked>
                <Content>
                    <span> Odszyfruj obraz </span>
                    @if (AlgorithmSingleton.Instance.ChosenAlgorithm is { } chosen)
                    {
                        <small style="color: var(--widget-text-color-muted);">używając algorytmu <strong>@chosen.Name</strong></small>
                    }
                </Content>
            </DecryptionWidget>
        </div>
        @{
            if (_isPopupOpen)
            {
                switch (_lastWidgetCallingPopup)
                {
                    case Shared.WidgetType.History:
                        <HistoryPopupWidget ActionRequestedEvent=OnWidgetClicked ButtonPushedEvent=OnButtonClicked />
                        break;
                    case Shared.WidgetType.Histograms:
                        <HistogramsPopupWidget ActionRequestedEvent=OnWidgetClicked ButtonPushedEvent=OnButtonClicked />
                        break;
                    case Shared.WidgetType.Algorithms:
                        <AlgorithmPopupWidget ActionRequestedEvent=OnWidgetClicked ButtonPushedEvent=OnButtonClicked />
                        break;
                }
            }
        }
    </div>
</section>