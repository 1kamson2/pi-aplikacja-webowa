@page "/control-panel"

@layout Components.Layout.MainLayout
@inherits Core.Components.Pages.BasePage
@using Core.Utils

<section class="workspace-canvas anim-control-panel" @onwheel="OnMouseScroll">
    <div class="widget widget-dashboard">
        <div class="widget-container">
            <div class="widget" @onclick="SaveImage">
                <span> Save Image </span>
            </div>
            <div class="widget" @onclick="OpenEncryptionHistory">
                <span> Encryption history </span>
                <div class="scrollable">
                    @{
                        var sequence = GetButtonsByType(Elements.Button.Type.EncryptionHistory);
                        if (!sequence.Any())
                        {
                            <span> This is empty. </span>
                        } else
                        {
                            foreach (var button in sequence)
                            {
                                <button class="widget widget-button" @onclick="() => OnButtonClicked(button.Type, button.Id)"> @button.Content </button>
                            }
                        }
                    }
                </div>
            </div>
            <div class="widget">
                <span> Histograms </span>
                <div class="scrollable">
                    @{
                        sequence = GetButtonsByType(Elements.Button.Type.EncryptionHistory);
                        if (!sequence.Any())
                        {
                            <span> This is empty. </span>
                        }
                        else
                        {
                            foreach (var button in sequence)
                            {
                                <button class="widget widget-button" @onclick="() => OnButtonClicked(button.Type, button.Id)"> @button.Content </button>
                            }
                        }
                    }
                </div>
            </div>
            <div class="widget">
                <span> Algorithms </span>
                <div class="scrollable">
                    @{
                        sequence = GetButtonsByType(Elements.Button.Type.EncryptionHistory);
                        if (!sequence.Any())
                        {
                            <span> This is empty. </span>
                        }
                        else
                        {
                            foreach (var button in sequence)
                            {
                                <button class="widget widget-button" @onclick="() => OnButtonClicked(button.Type, button.Id)"> @button.Content </button>
                            }
                        }
                    }
                </div>
            </div>
        </div>
        <div class="widget">
            <span>Encrypted Image</span>
            <small>(will display after hitting encrypt)</small>
        </div>
    </div>
</section>
